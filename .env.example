# Server-only Shopify app credentials. Do not expose these with VITE_ prefixes.
SHOPIFY_STORE_DOMAIN=xagsqp-u0.myshopify.com
SHOPIFY_CLIENT_ID=your_shopify_dev_dashboard_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_dev_dashboard_client_secret
SHOPIFY_API_VERSION=2026-07

# Customer social sign-in. Configure Google and Facebook providers in Supabase Auth,
# and add https://www.radiant34.com/ plus the Vercel preview URLs to the redirect allowlist.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
